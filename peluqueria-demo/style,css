/* ESTILOS GENERALES */
* {
margin: 0;
padding: 0;
box-sizing: border-box;
}

body {
font-family: Arial, sans-serif;
background-color: #111111;
color: #ffffff;
}

/* ENCABEZADO */
header {
background-color: #000000;
padding: 25px;
text-aling: center;
border-bottom: 2px solid #c9a227;
}

header h1 {
color: #d4af37;
font-size: 36px;
}

header p {
color: #ffffff;
margin-top: 10px;
}

/* MENU */
nav {
background-color: #1c1c1c;
padding: 15px;
text-aling: center;
}

nav a {
color: #d4af37;
text-decoration: nome;
margin: 15px;
font-weigth: bold;
}

/* CONTENIDO /*
main {
padding: 40px 20px;
text-aling: center;
}

section {
margin-bottom: 40px;
}

h2 {
color: #d4af37;
margin-bottom: 20px;
}

p {
line-height: 1.7;
}

/* BOTONES */
button, .boton {
background-color: #d4af37;
color: #000000;
padding: 12px 25px;
border: none;
border-radius: 6px;
text-decoration: none;
font-weight: bold;
cursor: pointer;
}

/* IMAGENES */
img {
max-width: 100%;
height: auto;
border-radius: 10px;
}

/* PIE DE PAGINA */
footer {
background-color: #000000;
color: #d4af37;
padding: 20px;
border-top: 2px solid #d4af37;
}

/* CELULARES */
@media (max-width: 768px) {
header h1 {
font-size: 28px;
}

nav a {
display: inline-block;
margin: 8px;
}

main {
padding: 25px 15px;
}
}
